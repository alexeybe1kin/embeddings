# Copy to .env next to docker-compose.yml. .env is gitignored; never commit it.
# Precedence is environment -> file -> default.

# Required. The service refuses to start without it. At least 16 characters.
#   echo "EMBEDDINGS_ADMIN_KEY=$(openssl rand -base64 24)" >> .env
EMBEDDINGS_ADMIN_KEY=

# Optional. The model, and the vector width it produces. Changing either
# invalidates every stored vector, so they are declared rather than inferred.
# EMBEDDINGS_MODEL=qwen3-embedding:0.6b
# EMBEDDINGS_DIMENSION=1024

# Low-resource preset, for a machine that cannot spare ~1.5 GB:
# EMBEDDINGS_MODEL=embeddinggemma:300m
# EMBEDDINGS_DIMENSION=768

# Optional. Where Ollama is.
# EMBEDDINGS_OLLAMA_URL=http://ollama:11434
